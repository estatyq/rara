# DoseMate Cloud v2 — Environment Configuration
NODE_ENV=development
API_PORT=4100
CORS_ORIGINS=http://localhost:5176,http://localhost:5175,capacitor://localhost,http://localhost

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://dosemate:dosemate_dev_password@localhost:5436/dosemate_v2?schema=public
# Dedicated runtime role with Row-Level Security enforced (non-superuser)
DATABASE_RUNTIME_URL=postgresql://dosemate_app:dosemate_app_password@localhost:5436/dosemate_v2?schema=public

# Queue, Realtime Pub/Sub & Rate-Limit (Valkey 8 / Redis 7)
REDIS_URL=redis://localhost:6389

# Auth & Encryption Secrets (MUST be strong random 32+ byte values in production)
JWT_ACCESS_SECRET=dev-access-secret-replace-in-prod-32bytes-minimum
JWT_REFRESH_SECRET=dev-refresh-secret-replace-in-prod-32bytes-minimum
SECRETS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_SECURE=false

# Object Storage (MinIO locally / Cloudflare R2 or AWS S3 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=dosemate-private
S3_ACCESS_KEY=dosemate_minio
S3_SECRET_KEY=dosemate_minio_secret

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:clinical-ops@dosemate.health

# Clinical Defaults
MISSED_AFTER_HOURS=3
CRITICAL_BP_ESCALATION_MINUTES=15
DEFAULT_TIMEZONE=Asia/Jakarta
VITE_ENABLE_DEMO=true
