# DoseLynx Production Environment (https://doselynx.com)
# Copy to .env.prod on the server and fill in strong secrets before running:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# PostgreSQL (use alphanumeric/hex password so DATABASE_URL needs no URL-encoding)
POSTGRES_DB=doselynx
POSTGRES_USER=doselynx
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

# JWT signing secret (at least 32 random bytes, e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-openssl-rand-hex-32

# Comma-separated allowed origins (Cloudflare HTTPS domain)
CORS_ORIGIN=https://doselynx.com,https://www.doselynx.com

# Cloudflare Zero Trust Tunnel token (from Networks -> Tunnels -> doselynx)
# Point Public Hostname doselynx.com (and www.doselynx.com) to HTTP service: app:4000
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Web Push (VAPID). Leave empty to auto-generate and persist in /app/data/vapid.json,
# or generate manually via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@doselynx.com

# Clinical & scheduler defaults
MISSED_AFTER_HOURS=3
DEFAULT_TIMEZONE=Asia/Jakarta

# Seed policy on startup: if_empty (recommended) | true | false
AUTO_SEED=if_empty

# Show quick demo sign-in buttons on /login (set false when going live with real patients)
VITE_ENABLE_DEMO=true
