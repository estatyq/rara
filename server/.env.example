PORT=4000
DATABASE_URL=postgresql://rara:rara@localhost:5435/rara?schema=public
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed origins for the web app (e.g. https://doselynx.com,https://www.doselynx.com)
CORS_ORIGIN=http://localhost:5175,http://localhost:5173
# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# In development the server generates and stores keys in server/.vapid.json if empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@doselynx.com
# After how many hours an unconfirmed dose is marked as MISSED
MISSED_AFTER_HOURS=3
DEFAULT_TIMEZONE=Asia/Jakarta
